<?xml version="1.0"?>
<skin name="border_15" version="0.0">

	<variables>
		<variable key="asset" value="habbo_border_hsv_layers_png" type="String" />
	</variables>

	<states>
		<state name="default" layout="border_15" template="border_15" />
		<state name="active" layout="border_15" template="border_15" />
	</states>

	<templates>
		<template name="border_15" asset="$asset">
			<entities>
				<entity name="dark_top_left" type="bitmap"><region><Rectangle x="2" y="2" width="5" height="5" /></region></entity>
				<entity name="dark_top_center" type="bitmap"><region><Rectangle x="7" y="2" width="4" height="5" /></region></entity>
				<entity name="dark_top_right" type="bitmap"><region><Rectangle x="11" y="2" width="5" height="5" /></region></entity>
				<entity name="dark_mid_left" type="bitmap"><region><Rectangle x="2" y="7" width="5" height="4" /></region></entity>
				<entity name="dark_mid_center" type="bitmap"><region><Rectangle x="7" y="7" width="4" height="4" /></region></entity>
				<entity name="dark_mid_right" type="bitmap"><region><Rectangle x="11" y="7" width="5" height="4" /></region></entity>
				<entity name="dark_btm_left" type="bitmap"><region><Rectangle x="2" y="11" width="5" height="5" /></region></entity>
				<entity name="dark_btm_center" type="bitmap"><region><Rectangle x="7" y="11" width="4" height="5" /></region></entity>
				<entity name="dark_btm_right" type="bitmap"><region><Rectangle x="11" y="11" width="5" height="5" /></region></entity>

				<entity name="mid_top_left" type="bitmap"><region><Rectangle x="2" y="20" width="5" height="5" /></region></entity>
				<entity name="mid_top_center" type="bitmap"><region><Rectangle x="7" y="20" width="4" height="5" /></region></entity>
				<entity name="mid_top_right" type="bitmap"><region><Rectangle x="11" y="20" width="5" height="5" /></region></entity>
				<entity name="mid_mid_left" type="bitmap"><region><Rectangle x="2" y="25" width="5" height="4" /></region></entity>
				<entity name="mid_mid_center" type="bitmap"><region><Rectangle x="7" y="25" width="4" height="4" /></region></entity>
				<entity name="mid_mid_right" type="bitmap"><region><Rectangle x="11" y="25" width="5" height="4" /></region></entity>
				<entity name="mid_btm_left" type="bitmap"><region><Rectangle x="2" y="29" width="5" height="5" /></region></entity>
				<entity name="mid_btm_center" type="bitmap"><region><Rectangle x="7" y="29" width="4" height="5" /></region></entity>
				<entity name="mid_btm_right" type="bitmap"><region><Rectangle x="11" y="29" width="5" height="5" /></region></entity>

				<entity name="light_top_left" type="bitmap"><region><Rectangle x="20" y="2" width="5" height="5" /></region></entity>
				<entity name="light_top_center" type="bitmap"><region><Rectangle x="25" y="2" width="4" height="5" /></region></entity>
				<entity name="light_top_right" type="bitmap"><region><Rectangle x="29" y="2" width="5" height="5" /></region></entity>
				<entity name="light_mid_left" type="bitmap"><region><Rectangle x="20" y="7" width="5" height="4" /></region></entity>
				<entity name="light_mid_center" type="bitmap"><region><Rectangle x="25" y="7" width="4" height="4" /></region></entity>
				<entity name="light_mid_right" type="bitmap"><region><Rectangle x="29" y="7" width="5" height="4" /></region></entity>
				<entity name="light_btm_left" type="bitmap"><region><Rectangle x="20" y="11" width="5" height="5" /></region></entity>
				<entity name="light_btm_center" type="bitmap"><region><Rectangle x="25" y="11" width="4" height="5" /></region></entity>
				<entity name="light_btm_right" type="bitmap"><region><Rectangle x="29" y="11" width="5" height="5" /></region></entity>
			</entities>
		</template>
	</templates>

	<layouts>
		<layout name="border_15" transparent="true">
			<entities>
				<entity name="dark_top_left" id="0" colorizeMethod="hsv_layer" shade="0.2"><region><Rectangle x="0" y="0" width="5" height="5" /></region><scale horizontal="fixed" vertical="fixed" /></entity>
				<entity name="dark_top_center" id="0" colorizeMethod="hsv_layer" shade="0.2"><region><Rectangle x="5" y="0" width="4" height="5" /></region><scale horizontal="strech" vertical="fixed" /></entity>
				<entity name="dark_top_right" id="0" colorizeMethod="hsv_layer" shade="0.2"><region><Rectangle x="9" y="0" width="5" height="5" /></region><scale horizontal="move" vertical="fixed" /></entity>
				<entity name="dark_mid_left" id="0" colorizeMethod="hsv_layer" shade="0.2"><region><Rectangle x="0" y="5" width="5" height="4" /></region><scale horizontal="fixed" vertical="strech" /></entity>
				<entity name="dark_mid_center" id="0" colorizeMethod="hsv_layer" shade="0.2"><region><Rectangle x="5" y="5" width="4" height="4" /></region><scale horizontal="strech" vertical="strech" /></entity>
				<entity name="dark_mid_right" id="0" colorizeMethod="hsv_layer" shade="0.2"><region><Rectangle x="9" y="5" width="5" height="4" /></region><scale horizontal="move" vertical="strech" /></entity>
				<entity name="dark_btm_left" id="0" colorizeMethod="hsv_layer" shade="0.2"><region><Rectangle x="0" y="9" width="5" height="5" /></region><scale horizontal="fixed" vertical="move" /></entity>
				<entity name="dark_btm_center" id="0" colorizeMethod="hsv_layer" shade="0.2"><region><Rectangle x="5" y="9" width="4" height="5" /></region><scale horizontal="strech" vertical="move" /></entity>
				<entity name="dark_btm_right" id="0" colorizeMethod="hsv_layer" shade="0.2"><region><Rectangle x="9" y="9" width="5" height="5" /></region><scale horizontal="move" vertical="move" /></entity>

				<entity name="mid_top_left" id="0" colorizeMethod="hsv_layer" shade="0.12"><region><Rectangle x="0" y="0" width="5" height="5" /></region><scale horizontal="fixed" vertical="fixed" /></entity>
				<entity name="mid_top_center" id="0" colorizeMethod="hsv_layer" shade="0.12"><region><Rectangle x="5" y="0" width="4" height="5" /></region><scale horizontal="strech" vertical="fixed" /></entity>
				<entity name="mid_top_right" id="0" colorizeMethod="hsv_layer" shade="0.12"><region><Rectangle x="9" y="0" width="5" height="5" /></region><scale horizontal="move" vertical="fixed" /></entity>
				<entity name="mid_mid_left" id="0" colorizeMethod="hsv_layer" shade="0.12"><region><Rectangle x="0" y="5" width="5" height="4" /></region><scale horizontal="fixed" vertical="strech" /></entity>
				<entity name="mid_mid_center" id="0" colorizeMethod="hsv_layer" shade="0.12"><region><Rectangle x="5" y="5" width="4" height="4" /></region><scale horizontal="strech" vertical="strech" /></entity>
				<entity name="mid_mid_right" id="0" colorizeMethod="hsv_layer" shade="0.12"><region><Rectangle x="9" y="5" width="5" height="4" /></region><scale horizontal="move" vertical="strech" /></entity>
				<entity name="mid_btm_left" id="0" colorizeMethod="hsv_layer" shade="0.12"><region><Rectangle x="0" y="9" width="5" height="5" /></region><scale horizontal="fixed" vertical="move" /></entity>
				<entity name="mid_btm_center" id="0" colorizeMethod="hsv_layer" shade="0.12"><region><Rectangle x="5" y="9" width="4" height="5" /></region><scale horizontal="strech" vertical="move" /></entity>
				<entity name="mid_btm_right" id="0" colorizeMethod="hsv_layer" shade="0.12"><region><Rectangle x="9" y="9" width="5" height="5" /></region><scale horizontal="move" vertical="move" /></entity>

				<entity name="light_top_left" id="0" colorizeMethod="hsv_layer" shade="0"><region><Rectangle x="0" y="0" width="5" height="5" /></region><scale horizontal="fixed" vertical="fixed" /></entity>
				<entity name="light_top_center" id="0" colorizeMethod="hsv_layer" shade="0"><region><Rectangle x="5" y="0" width="4" height="5" /></region><scale horizontal="strech" vertical="fixed" /></entity>
				<entity name="light_top_right" id="0" colorizeMethod="hsv_layer" shade="0"><region><Rectangle x="9" y="0" width="5" height="5" /></region><scale horizontal="move" vertical="fixed" /></entity>
				<entity name="light_mid_left" id="0" colorizeMethod="hsv_layer" shade="0"><region><Rectangle x="0" y="5" width="5" height="4" /></region><scale horizontal="fixed" vertical="strech" /></entity>
				<entity name="light_mid_center" id="0" colorizeMethod="hsv_layer" shade="0"><region><Rectangle x="5" y="5" width="4" height="4" /></region><scale horizontal="strech" vertical="strech" /></entity>
				<entity name="light_mid_right" id="0" colorizeMethod="hsv_layer" shade="0"><region><Rectangle x="9" y="5" width="5" height="4" /></region><scale horizontal="move" vertical="strech" /></entity>
				<entity name="light_btm_left" id="0" colorizeMethod="hsv_layer" shade="0"><region><Rectangle x="0" y="9" width="5" height="5" /></region><scale horizontal="fixed" vertical="move" /></entity>
				<entity name="light_btm_center" id="0" colorizeMethod="hsv_layer" shade="0"><region><Rectangle x="5" y="9" width="4" height="5" /></region><scale horizontal="strech" vertical="move" /></entity>
				<entity name="light_btm_right" id="0" colorizeMethod="hsv_layer" shade="0"><region><Rectangle x="9" y="9" width="5" height="5" /></region><scale horizontal="move" vertical="move" /></entity>
			</entities>
		</layout>
	</layouts>
</skin>
