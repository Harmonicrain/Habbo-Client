<?xml version="1.0" encoding="UTF-8"?>
<layout name="furni_view_branding_element_numeric" width="170" height="42" version="0.1" uid="80E15278-88CD-B55C-C879-8D1CC10E2D92">
  <window>
    <container x="0" y="0" width="170" height="42" params="16" style="0" tags="branding_element">
      <children>
        <border x="0" y="0" width="170" height="42" params="16" style="1" name="element_border">
          <children>
            <text x="0" y="0" width="160" height="12" params="144" style="0" name="element_name" caption="element%20name">
              <variables>
                <var key="font_face" value="Volter Bold" type="String"/>
                <var key="text_color" value="0xffffff" type="hex"/>
                <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
                <var key="word_wrap" value="true" type="Boolean"/>
              </variables>
            </text>
            <container_button x="7" y="18" width="20" height="20" params="17" style="1" name="element_minus">
              <children>
                <icon x="4" y="5" width="12" height="12" params="16" style="2" color="0x0666666"/>
              </children>
            </container_button>
            <input x="33" y="18" width="104" height="20" params="1" style="0" name="element_value" caption="0">
              <variables>
                <var key="always_show_selection" value="true" type="Boolean"/>
                <var key="border" value="true" type="Boolean"/>
                <var key="border_color" value="0xffffff" type="hex"/>
                <var key="text_color" value="0xffffff" type="hex"/>
                <var key="restrict" value="0123456789-" type="String"/>
