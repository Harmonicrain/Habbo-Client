<?xml version="1.0"?>
<skin name="illumina_light_skin_button_plain" version="0.0">

    <!-- shared variables -->
    <variables>
        <variable key="asset" value="illumina_light_button_frame_minimize_png" type="String"/>
    </variables>

    <!-- the following maps layouts for render states -->

    <states>
        <state name="default"  layout="illumina_light_button_frame_minimize" template="default_button_mode" />
        <state name="pressed"  layout="illumina_light_button_frame_minimize" template="pressed_button_mode" />
        <state name="hovering" layout="illumina_light_button_frame_minimize" template="hovering_button_mode" />
    </states>

    <!-- templates defines regions in bitmap asset -->

    <templates>

        <template name="default_button_mode" asset="$asset">
            <entities>
                <entity name="illumina_light_button_frame_minimize" type="bitmap"><region><Rectangle x="0" y="0"  width="20" height="20" /></region></entity>
            </entities>
        </template>

        <template name="pressed_button_mode" asset="$asset">
            <entities>
                <entity name="illumina_light_button_frame_minimize" type="bitmap"><region><Rectangle x="26" y="0"  width="20" height="20" /></region></entity>
            </entities>
        </template>

        <template name="hovering_button_mode" asset="$asset">
            <entities>
                <entity name="illumina_light_button_frame_minimize" type="bitmap"><region><Rectangle x="52"  y="0"  width="20" height="20" /></region></entity>
            </entities>
        </template>


    </templates>

    <!-- markup for layout drawer -->

    <layouts>
        <layout name="illumina_light_button_frame_minimize" transparent="false">
            <entities>
                <entity name="illumina_light_button_frame_minimize" id="0">
                    <region><Rectangle x="0" y="0" width="20" height="20" /></region>
                    <scale horizontal="fixed" vertical="fixed" />
                </entity>
            </entities>
        </layout>
    </layouts>
</skin>
