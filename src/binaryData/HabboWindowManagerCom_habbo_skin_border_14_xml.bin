<?xml version="1.0"?>
<skin name="border_14" version="0.0">

	<!-- shared variables -->

	<variables>
		<variable key="asset"	value="habbo_skin_ubuntu_png"	type="String" />
	</variables>

	<!-- the following maps layouts for render states -->

	<states>
		<state name="default"  layout="border_14" template="border_14" />
		<state name="active"   layout="border_14" template="border_14" />
	</states>

	<!-- templates defines regions in bitmap asset -->

	<templates>

		<template name="border_14" asset="$asset">
			<entities>
				<entity name="top_left"	  type="bitmap"><region><Rectangle x="153" y="160" width="10" height="10" /></region></entity>
				<entity name="top_center" type="bitmap"><region><Rectangle x="163" y="160" width="5" height="10" /></region></entity>
				<entity name="top_right"  type="bitmap"><region><Rectangle x="168" y="160" width="10" height="10" /></region></entity>

				<entity name="mid_left"	  type="bitmap"><region><Rectangle x="153" y="170" width="10" height="5" /></region></entity>
				<entity name="mid_center" type="bitmap"><region><Rectangle x="163" y="170" width="5" height="5" /></region></entity>
				<entity name="mid_right"  type="bitmap"><region><Rectangle x="168" y="170" width="10" height="5" /></region></entity>

				<entity name="btm_left"	  type="bitmap"><region><Rectangle x="153" y="175" width="10" height="10" /></region></entity>
				<entity name="btm_center" type="bitmap"><region><Rectangle x="163" y="175" width="5" height="10" /></region></entity>
				<entity name="btm_right"  type="bitmap"><region><Rectangle x="168" y="175" width="10" height="10" /></region></entity>
			</entities>
		</template>

	</templates>

	<!-- markup for layout drawer -->

	<layouts>
		<layout name="border_14" transparent="true">
			<entities>

				<entity name="top_left" id="0">
					<region><Rectangle x="0" y="0" width="10" height="10" /></region>
					<scale horizontal="fixed" vertical="fixed" />
				</entity>

				<entity name="top_center" id="0">
					<region><Rectangle x="10" y="0" width="5" height="10" /></region>
					<scale horizontal="strech" vertical="fixed" />
				</entity>

				<entity name="top_right" id="0">
					<region><Rectangle x="15" y="0" width="10" height="10" /></region>
					<scale horizontal="move" vertical="fixed" />
				</entity>

				<entity name="mid_left" id="0">
					<region><Rectangle x="0" y="10" width="10" height="5" /></region>
					<scale horizontal="fixed" vertical="strech" />
				</entity>

				<entity name="mid_center" id="0">
					<region><Rectangle x="10" y="10" width="5" height="5" /></region>
					<scale horizontal="strech" vertical="strech" />
				</entity>

				<entity name="mid_right" id="0">
					<region><Rectangle x="15" y="10" width="10" height="5" /></region>
					<scale horizontal="move" vertical="strech" />
				</entity>

				<entity name="btm_left" id="0">
					<region><Rectangle x="0" y="15" width="10" height="10" /></region>
					<scale horizontal="fixed" vertical="move" />
				</entity>

				<entity name="btm_center" id="0">
					<region><Rectangle x="10" y="15" width="5" height="10" /></region>
					<scale horizontal="strech" vertical="move" />
				</entity>

				<entity name="btm_right" id="0">
					<region><Rectangle x="15" y="15" width="10" height="10" /></region>
					<scale horizontal="move" vertical="move" />
				</entity>

			</entities>

		</layout>
	</layouts>
</skin>
