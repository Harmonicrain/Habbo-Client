	<!-- markup for layout drawer -->

	<layouts>
		<layout name="icon10" transparent="true">
			<entities>
				<entity name="icon" id="0">
					<region><Rectangle x="0" y="0" width="27" height="24" /></region>
					<scale horizontal="fixed" vertical="fixed" />
