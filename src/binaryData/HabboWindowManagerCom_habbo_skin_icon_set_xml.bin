<?xml version="1.0"?>
<skin name="icon_set_skin" version="0.0">

	<!-- shared variables -->

	<variables>
		<variable key="asset" value="habbo_icons_png" type="String" />
	</variables>

	<!-- template defines regions in bitmap asset -->

	<templates>

		<!-- Simple arrow down -->
		<template name="icon_0" asset="$asset">
			<entities>
				<entity name="icon" type="bitmap"><region><Rectangle x="0" y="0"  width="9" height="10" /></region></entity>
			</entities>
		</template>

		<!-- Simple arrow up -->
		<template name="icon_1" asset="$asset">
			<entities>
				<entity name="icon" type="bitmap"><region><Rectangle x="10" y="0"  width="9" height="10" /></region></entity>
