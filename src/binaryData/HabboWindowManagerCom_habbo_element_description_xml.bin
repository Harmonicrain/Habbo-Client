<?xml version="1.0"?>
<skin name="habbo" version="0.1">

	<!-- Window types -->
    <window type="null"			intent="default" style="0"	renderer="skin"	asset="habbo_skin_frame_xml"			layout="null" />

    <!-- Defaults -->
    <window type="container"	intent="default" style="0"	renderer="null"	/>
    <window type="bitmap"		intent="default" style="0"	renderer="bitmap" />
    <window type="static_bitmap"    intent="default" style="0"   renderer="bitmap" />
    <window type="background"		intent="default" style="0"	renderer="null"	/>

    <window type="text"						intent="default" style="0"	renderer="text" asset="text_styles_css"	/>
    <window type="formatted_text"			intent="default" style="0"	renderer="text" asset="text_styles_css"	/>
    <window type="label"					intent="default" style="0"	renderer="label" asset="text_styles_css" />
    <window type="password"					intent="default" style="0"	renderer="text" asset="text_styles_css" />
    <window type="link"						intent="default" style="0"	renderer="text" asset="text_styles_css"	/>

    <!-- Volter Defaults -->
    <window type="border"		intent="white with sharper corners" style="3"	renderer="skin" asset="habbo_skin_border_slot_xml"		layout="border_slot" />
    <window type="border"		intent="white with thin dark border" style="4"	renderer="skin" asset="habbo_skin_border_4_xml"	        layout="border_4" />
    <window type="border"		intent="white with thin dark border and sharper corners" style="5"	renderer="skin" asset="habbo_skin_border_5_xml"	        layout="border_5" />
    <window type="border"		intent="grey with thick border" style="6"	renderer="skin" asset="habbo_skin_border_6_xml"	        layout="border_6" />
    <window type="border"		intent="grey with thin border" style="7"	renderer="skin" asset="habbo_skin_border_7_xml"	        layout="border_7" />
    <window type="border"		intent="white with thick dark border" style="8"	renderer="skin" asset="habbo_skin_border_8_xml"	        layout="border_8" />
    <window type="border"		intent="transp. grey with thick border" style="9"	renderer="skin" asset="habbo_skin_border_9_xml"	        layout="border_9" />

    <!-- New navigator -->
    <window type="border"		intent="white with drop shadow" style="10"	renderer="skin"	asset="habbo_skin_border_colorless_dropshadow_xml"	layout="border_colorless_dropshadow" />

    <!-- Bubble -->
    <window type="bubble"					intent="default" style="0"	renderer="skin"	asset="habbo_skin_bubble_xml"               window_layout="habbo_window_layout_bubble_xml" layout="bubble"	/>
    <window type="bubble_pointer_up"		intent="default" style="0"	renderer="skin"	asset="habbo_skin_bubble_pointer_up_xml"	layout="pointer_up"   />
    <window type="bubble_pointer_right"		intent="default" style="0"	renderer="skin"	asset="habbo_skin_bubble_pointer_right_xml"	layout="pointer_right"   />
    <window type="bubble_pointer_down"		intent="default" style="0"	renderer="skin"	asset="habbo_skin_bubble_pointer_down_xml"	layout="pointer_down"   />
    <window type="bubble_pointer_left"		intent="default" style="0"	renderer="skin"	asset="habbo_skin_bubble_pointer_left_xml"	layout="pointer_left"   />

        <!-- ubuntu bubble -->
     <window type="bubble"                  intent="default" style="7"  renderer="skin" asset="habbo_skin_bubble_7_xml"               
        window_layout="habbo_window_layout_bubble_7_xml" layout="bubble_7" />
    <window type="bubble_pointer_up"        intent="default" style="7"  renderer="skin" asset="habbo_skin_bubble_pointer_up_7_xml"    layout="pointer_up_7" />
    <window type="bubble_pointer_right"     intent="default" style="7"  renderer="skin" asset="habbo_skin_bubble_pointer_right_7_xml" layout="pointer_right_7"   />
    <window type="bubble_pointer_down"      intent="default" style="7"  renderer="skin" asset="habbo_skin_bubble_pointer_down_7_xml"  layout="pointer_down_7"   />
    <window type="bubble_pointer_left"      intent="default" style="7"  renderer="skin" asset="habbo_skin_bubble_pointer_left_7_xml"  layout="pointer_left_7"   />

    <window type="tab_context"			intent="default" style="0"	renderer="null" asset="habbo_skin_tab_context_xml"				window_layout="habbo_window_layout_tab_context_xml" layout="tab_context" />
    <window type="tooltip"			    intent="default" style="0"	renderer="skin" asset="habbo_skin_tooltip_xml"					window_layout="habbo_window_layout_tooltip_xml" layout="tooltip" />

    <window type="scrollable_itemlist_vertical" intent="default" style="0" renderer="null" window_layout="habbo_window_layout_scrollable_itemlist_vertical_xml" />
    <window type="scrollable_itemgrid_vertical" intent="default" style="0" renderer="null" window_layout="habbo_window_layout_scrollable_itemgrid_vertical_xml" />

    <!-- Volter Blue -->
	<window type="frame"		intent="blue" style="0"	renderer="skin"	asset="habbo_skin_frame_xml"			window_layout="habbo_window_layout_frame_xml" layout="frame" color="0xff418db0" />
    <window type="border"		intent="white with thin light border" style="0"	renderer="skin"	asset="habbo_skin_border_white_xml"		layout="border_white"	/>
    <window type="header"		intent="blue" style="0"	renderer="skin"	asset="habbo_skin_header_xml"			window_layout="habbo_window_layout_header_xml" layout="header"	color="0xff418db0" treshold="1" />
	<window type="button"				intent="default" style="0"	renderer="skin"	asset="habbo_skin_button_default_xml"				window_layout="habbo_window_layout_button_xml" layout="button" />
	<window type="button_thick"			intent="default" style="0"	renderer="skin" asset="habbo_skin_button_thick_xml"					window_layout="habbo_window_layout_button_thick_xml" layout="button_thick" />
    <window type="container_button"		intent="default" style="0"	renderer="skin" asset="habbo_skin_button_default_xml"			layout="button" />
	<window type="button_group_left"	intent="default" style="0"	renderer="skin" asset="habbo_skin_button_group_left_xml"	        window_layout="habbo_window_layout_button_xml" layout="button_group_left" />
	<window type="button_group_center"	intent="default" style="0"	renderer="skin" asset="habbo_skin_button_group_center_xml"	        window_layout="habbo_window_layout_button_xml" layout="button_group_center" />
	<window type="button_group_right"	intent="default" style="0"	renderer="skin" asset="habbo_skin_button_group_right_xml"           window_layout="habbo_window_layout_button_xml" layout="button_group_right" />
	<window type="scaler"				intent="default" style="0"	renderer="skin"	asset="habbo_skin_scaler_xml"					window_layout="habbo_window_layout_scaler_xml" layout="scaler" />
    <window type="closebutton"			intent="default" style="0"	renderer="skin"	asset="habbo_skin_button_close_xml"				layout="button_close"		treshold="0" background="true" />
	<window type="dropmenu"				intent="default" style="0"	renderer="skin"	asset="habbo_skin_dropmenu_xml"					window_layout="habbo_window_layout_dropmenu_xml" layout="dropmenu_frame" />
	<window type="dropmenu_item"		intent="default" style="0"	renderer="skin"	asset="habbo_skin_dropmenu_xml"					window_layout="habbo_window_layout_dropmenu_item_xml" layout="dropmenu_item" />
	<window type="radiobutton"			intent="default" style="0"	renderer="skin"	asset="habbo_skin_button_radio_xml"				layout="button_radio" />
	<window type="checkbox"				intent="default" style="0"	renderer="skin"	asset="habbo_skin_button_checkbox_xml"			layout="button_checkbox" />
	<window type="tab_button"			intent="default" style="0"	renderer="skin" asset="habbo_skin_button_tab_xml"				window_layout="habbo_window_layout_tab_button_xml" layout="button_tab" />
	<window type="tab_container_button"	intent="default" style="0"	renderer="skin" asset="habbo_skin_button_tab_xml"				layout="button_tab" />
	<window type="tab_content"			intent="default" style="0"	renderer="skin" asset="habbo_skin_border_white_xml"				layout="border_white" />
    <window type="droplist"			    intent="default" style="0"	renderer="skin"	asset="habbo_skin_droplist_xml"					window_layout="habbo_window_layout_droplist_xml" layout="droplist_frame" />
    <window type="droplist_item"	    intent="default" style="0"	renderer="skin"	asset="habbo_skin_droplist_xml"					layout="droplist_item" />
    <window type="scrollbar_horizontal"					intent="default" style="0"	renderer="skin"	asset="habbo_skin_scrollbar_xml"	window_layout="habbo_window_layout_scrollbar_horizontal_xml" layout="scrollbar_horizontal" />
    <window type="scrollbar_vertical"					intent="default" style="0"	renderer="skin"	asset="habbo_skin_scrollbar_xml"	window_layout="habbo_window_layout_scrollbar_vertical_xml" layout="scrollbar_vertical" />
    <window type="scrollbar_slider_button_up"			intent="default" style="0"	renderer="skin"	asset="habbo_skin_scrollbar_xml"	layout="scrollbar_button_up"		/>
    <window type="scrollbar_slider_button_down"			intent="default" style="0"	renderer="skin"	asset="habbo_skin_scrollbar_xml"	layout="scrollbar_button_down"		/>
    <window type="scrollbar_slider_button_left"			intent="default" style="0"	renderer="skin"	asset="habbo_skin_scrollbar_xml"	layout="scrollbar_button_left"		/>
    <window type="scrollbar_slider_button_right"		intent="default" style="0"	renderer="skin"	asset="habbo_skin_scrollbar_xml"	layout="scrollbar_button_right"		/>
    <window type="scrollbar_slider_track_horizontal"	intent="default" style="0"	renderer="skin"	asset="habbo_skin_scrollbar_xml"	layout="scrollbar_track_horizontal"	/>
    <window type="scrollbar_slider_track_vertical"		intent="default" style="0"	renderer="skin"	asset="habbo_skin_scrollbar_xml"	layout="scrollbar_track_vertical"	/>
    <window type="scrollbar_slider_bar_horizontal"		intent="default" style="0"	renderer="skin"	asset="habbo_skin_scrollbar_xml"	layout="scrollbar_lift_horizontal"	/>
    <window type="scrollbar_slider_bar_vertical"		intent="default" style="0"	renderer="skin"	asset="habbo_skin_scrollbar_xml"	layout="scrollbar_lift_vertical"	/>


    <!-- Volter Black -->
	<window type="frame"		intent="black" style="1"	renderer="skin"	asset="habbo_skin_frame_xml"			window_layout="habbo_window_layout_frame_xml" layout="frame" color="0xff4c4c4c" />
	<window type="border"		intent="black borderless" style="1"	renderer="skin"	asset="habbo_skin_border_black_xml"		layout="border_black" />
	<window type="header"		intent="black" style="1"	renderer="skin"	asset="habbo_skin_header_xml"			window_layout="habbo_window_layout_header_black_xml" layout="header" color="0xff4c4c4c" treshold="1" />
	<window type="button"				intent="black" style="1"	renderer="skin" asset="habbo_skin_button_default_black_xml"			window_layout="habbo_window_layout_button_black_xml" layout="button_black" />
	<window type="button_thick"			intent="black" style="1"	renderer="skin" asset="habbo_skin_button_thick_black_xml"			window_layout="habbo_window_layout_button_thick_black_xml" layout="button_thick_black" />
    <window type="container_button"		intent="black" style="1"	renderer="skin" asset="habbo_skin_button_default_black_xml"		layout="button_black" />
	<window type="button_group_left"	intent="black" style="1"	renderer="skin" asset="habbo_skin_button_group_left_black_xml"      window_layout="habbo_window_layout_button_black_xml" layout="button_group_left_black" />
	<window type="button_group_center"	intent="black" style="1"	renderer="skin" asset="habbo_skin_button_group_center_black_xml"    window_layout="habbo_window_layout_button_black_xml" layout="button_group_center_black" />
	<window type="button_group_right"	intent="black" style="1"	renderer="skin" asset="habbo_skin_button_group_right_black_xml"     window_layout="habbo_window_layout_button_black_xml" layout="button_group_right_black" />
	<window type="scaler"				intent="black" style="1"	renderer="skin"	asset="habbo_skin_scaler_xml"					window_layout="habbo_window_layout_scaler_xml" layout="scaler" />
	<window type="closebutton"			intent="black" style="1"	renderer="skin"	asset="habbo_skin_button_close_black_xml"		layout="button_close_black"	treshold="0" background="true" />
	<window type="dropmenu"				intent="black" style="1"	renderer="skin"	asset="habbo_skin_dropmenu_black_xml"			window_layout="habbo_window_layout_dropmenu_black_xml" layout="dropmenu_frame_black" />
    <window type="dropmenu_item"		intent="black" style="1"	renderer="skin"	asset="habbo_skin_dropmenu_black_xml"			window_layout="habbo_window_layout_dropmenu_item_black_xml" layout="dropmenu_item_black" />
	<window type="radiobutton"			intent="black" style="1"	renderer="skin"	asset="habbo_skin_button_radio_black_xml"		layout="button_radio_black" />
	<window type="checkbox"				intent="black" style="1"	renderer="skin"	asset="habbo_skin_button_checkbox_black_xml"	layout="button_checkbox_black" />
	<window type="tab_button"			intent="black" style="1"	renderer="skin" asset="habbo_skin_button_tab_black_xml"			window_layout="habbo_window_layout_tab_button_black_xml" layout="button_tab_black" />
	<window type="tab_container_button"	intent="black" style="1"	renderer="skin" asset="habbo_skin_button_tab_black_xml"			layout="button_tab_black" />
	<window type="tab_content"			intent="black" style="1"	renderer="skin" asset="habbo_skin_border_black_xml"				layout="border_black" />
    <window type="droplist"			    intent="white" style="1"	renderer="skin"	asset="habbo_skin_droplist_thick_xml"			window_layout="habbo_window_layout_droplist_xml" layout="droplist_thick_frame" />
    <window type="droplist_item"	    intent="white" style="1"	renderer="skin"	asset="habbo_skin_droplist_xml"			        layout="droplist_item" />
    <window type="scrollbar_horizontal"					intent="black" style="1"	renderer="skin"	asset="habbo_skin_scrollbar_black_xml"	window_layout="habbo_window_layout_scrollbar_horizontal_xml" layout="scrollbar_horizontal_black" />
    <window type="scrollbar_vertical"					intent="black" style="1"	renderer="skin"	asset="habbo_skin_scrollbar_black_xml"	window_layout="habbo_window_layout_scrollbar_vertical_xml" layout="scrollbar_vertical_black" />
    <window type="scrollbar_slider_button_up"			intent="black" style="1"	renderer="skin"	asset="habbo_skin_scrollbar_black_xml"	layout="scrollbar_button_up_black"			/>
    <window type="scrollbar_slider_button_down"			intent="black" style="1"	renderer="skin"	asset="habbo_skin_scrollbar_black_xml"	layout="scrollbar_button_down_black"		/>
    <window type="scrollbar_slider_button_left"			intent="black" style="1"	renderer="skin"	asset="habbo_skin_scrollbar_black_xml"	layout="scrollbar_button_left_black"		/>
    <window type="scrollbar_slider_button_right"		intent="black" style="1"	renderer="skin"	asset="habbo_skin_scrollbar_black_xml"	layout="scrollbar_button_right_black"		/>
    <window type="scrollbar_slider_track_horizontal"	intent="black" style="1"	renderer="skin"	asset="habbo_skin_scrollbar_black_xml"	layout="scrollbar_track_horizontal_black"	/>
    <window type="scrollbar_slider_track_vertical"		intent="black" style="1"	renderer="skin"	asset="habbo_skin_scrollbar_black_xml"	layout="scrollbar_track_vertical_black"		/>
    <window type="scrollbar_slider_bar_horizontal"		intent="black" style="1"	renderer="skin"	asset="habbo_skin_scrollbar_black_xml"	layout="scrollbar_lift_horizontal_black"	/>
    <window type="scrollbar_slider_bar_vertical"		intent="black" style="1"	renderer="skin"	asset="habbo_skin_scrollbar_black_xml"	layout="scrollbar_lift_vertical_black"		/>

    <!-- Volter Yellow -->
    <window type="frame"		intent="yellow" style="2"	renderer="skin"	asset="habbo_skin_frame_xml"			window_layout="habbo_window_layout_frame_xml" layout="frame" color="0xfffac200" />
	<window type="border"		intent="white borderless" style="2"	renderer="skin"	asset="habbo_skin_border_colorless_xml"	layout="border_colorless" />
	<window type="header"		intent="yellow" style="2"	renderer="skin"	asset="habbo_skin_header_xml"			window_layout="habbo_window_layout_header_xml" layout="header"	color="0xfffac200" treshold="1" />
	<window type="button"				intent="white" style="2"	renderer="skin" asset="habbo_skin_button_default_white_xml"			window_layout="habbo_window_layout_button_xml" layout="button_white" />
	<window type="button_thick"			intent="white" style="2"	renderer="skin" asset="habbo_skin_button_thick_white_xml"			window_layout="habbo_window_layout_button_thick_xml" layout="button_thick_white" />
    <window type="container_button"		intent="white" style="2"	renderer="skin" asset="habbo_skin_button_default_white_xml"		layout="button_white" />
	<window type="button_group_left"	intent="white" style="2"	renderer="skin" asset="habbo_skin_button_group_left_white_xml"      window_layout="habbo_window_layout_button_xml" layout="button_group_left_white" />
	<window type="button_group_center"	intent="white" style="2"	renderer="skin" asset="habbo_skin_button_group_center_white_xml"    window_layout="habbo_window_layout_button_xml" layout="button_group_center_white" />
	<window type="button_group_right"	intent="white" style="2"	renderer="skin" asset="habbo_skin_button_group_right_white_xml"     window_layout="habbo_window_layout_button_xml" layout="button_group_right_white" />
	<window type="scaler"				intent="white" style="2"	renderer="skin"	asset="habbo_skin_scaler_xml"					window_layout="habbo_window_layout_scaler_xml" layout="scaler" />
	<window type="closebutton"			intent="white" style="2"	renderer="skin"	asset="habbo_skin_button_close_white_xml"		layout="button_close_white"	treshold="0" background="true" />
	<window type="radiobutton"			intent="white" style="2"	renderer="skin"	asset="habbo_skin_button_radio_white_xml"		layout="button_radio_white" />
	<window type="checkbox"				intent="white" style="2"	renderer="skin"	asset="habbo_skin_button_checkbox_white_xml"	layout="button_checkbox_white" />
	<window type="tab_button"			intent="white" style="2"	renderer="skin" asset="habbo_skin_button_tab_white_xml"			window_layout="habbo_window_layout_tab_button_xml" layout="button_tab_white" />
	<window type="tab_container_button"	intent="white" style="2"	renderer="skin" asset="habbo_skin_button_tab_white_xml"			layout="button_tab_white" />
	<window type="tab_content"			intent="white" style="2"	renderer="skin" asset="habbo_skin_border_colorless_xml"			layout="border_colorless" />



    <!-- Ubuntu Default -->
    <window type="frame"		intent="default" style="3"	renderer="skin"	asset="habbo_skin_frame_3_xml"			window_layout="habbo_window_layout_frame_3_xml" layout="frame_3" color="0xff418db0" />
    <window type="header"		intent="default" style="3"	renderer="skin"	asset="habbo_skin_header_3_xml"			window_layout="habbo_window_layout_header_3_xml" layout="header_3"	color="0xffffffff" treshold="0" />
    <window type="scaler"				intent="default" style="3"	renderer="skin"	asset="habbo_skin_scaler_3_xml"					window_layout="habbo_window_layout_scaler_3_xml" layout="scaler_3" />
    <window type="button"				intent="default" style="3"	renderer="skin" asset="habbo_skin_button_shiny_default_xml"			window_layout="habbo_window_layout_button_shiny_xml" layout="button_shiny"	/>
    <window type="button_thick"			intent="default" style="3"	renderer="skin" asset="habbo_skin_button_shiny_thick_xml"			window_layout="habbo_window_layout_button_shiny_thick_xml" layout="button_shiny_thick"	/>
    <window type="container_button"		intent="default" style="3"	renderer="skin" asset="habbo_skin_button_shiny_thick_xml"		layout="button_shiny_thick"	/>
    <window type="closebutton"			intent="default" style="3"	renderer="skin"	asset="habbo_skin_button_close_3_xml"			layout="button_close_3"		treshold="0" background="true" />
    <window type="dropmenu"				intent="default" style="3"	renderer="skin"	asset="habbo_skin_dropmenu_3_xml"				window_layout="habbo_window_layout_dropmenu_3_xml" layout="dropmenu_frame_3" />
    <window type="dropmenu_item"		intent="default" style="3"	renderer="skin"	asset="habbo_skin_dropmenu_3_xml"				window_layout="habbo_window_layout_dropmenu_item_3_xml" layout="dropmenu_item_3" />
    <window type="tab_button"			intent="default" style="3"	renderer="skin" asset="habbo_skin_button_tab_3_xml"				window_layout="habbo_window_layout_tab_button_3_xml" layout="button_tab_3" />
    <window type="tab_container_button"	intent="default" style="3"	renderer="skin" asset="habbo_skin_button_tab_3_xml"			    layout="button_tab_3" />
    <window type="tab_content"			intent="default" style="3"	renderer="skin" asset="habbo_skin_tab_content_3_xml"			layout="tab_content_3" />
    <window type="tab_context"			intent="default" style="3"	renderer="null" asset="habbo_skin_tab_context_xml"				window_layout="habbo_window_layout_tab_context_3_xml" layout="tab_context" />
    <window type="scrollbar_horizontal"					intent="default" style="3"	renderer="skin"	asset="habbo_skin_scrollbar_3_xml"	window_layout="habbo_window_layout_scrollbar_horizontal_xml" layout="scrollbar_horizontal_3" />
    <window type="scrollbar_vertical"					intent="default" style="3"	renderer="skin"	asset="habbo_skin_scrollbar_3_xml"	window_layout="habbo_window_layout_scrollbar_vertical_xml" layout="scrollbar_vertical_3" />
    <window type="scrollbar_slider_button_up"			intent="default" style="3"	renderer="skin"	asset="habbo_skin_scrollbar_3_xml"	layout="scrollbar_button_up_3"			/>
    <window type="scrollbar_slider_button_down"			intent="default" style="3"	renderer="skin"	asset="habbo_skin_scrollbar_3_xml"	layout="scrollbar_button_down_3"		/>
    <window type="scrollbar_slider_button_left"			intent="default" style="3"	renderer="skin"	asset="habbo_skin_scrollbar_3_xml"	layout="scrollbar_button_left_3"		/>
    <window type="scrollbar_slider_button_right"		intent="default" style="3"	renderer="skin"	asset="habbo_skin_scrollbar_3_xml"	layout="scrollbar_button_right_3"		/>
    <window type="scrollbar_slider_track_horizontal"	intent="default" style="3"	renderer="skin"	asset="habbo_skin_scrollbar_3_xml"	layout="scrollbar_track_horizontal_3"	/>
    <window type="scrollbar_slider_track_vertical"		intent="default" style="3"	renderer="skin"	asset="habbo_skin_scrollbar_3_xml"	layout="scrollbar_track_vertical_3"		/>
    <window type="scrollbar_slider_bar_horizontal"		intent="default" style="3"	renderer="skin"	asset="habbo_skin_scrollbar_3_xml"	layout="scrollbar_lift_horizontal_3"	/>
    <window type="scrollbar_slider_bar_vertical"		intent="default" style="3"	renderer="skin"	asset="habbo_skin_scrollbar_3_xml"	layout="scrollbar_lift_vertical_3"		/>
    <window type="scrollable_itemlist_vertical" intent="default" style="3" renderer="null" window_layout="habbo_window_layout_scrollable_itemlist_vertical_ubuntu_xml" />
    <window type="scrollable_itemgrid_vertical" intent="default" style="3" renderer="null" window_layout="habbo_window_layout_scrollable_itemgrid_vertical_ubuntu_xml" />

    <!-- Ubuntu Black -->
